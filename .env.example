# Plex API
PLEX_HOST=http://plex.local:32400
PLEX_TOKEN=your_plex_token

# NAS
NAS_IP=192.168.1.10
NAS_SSH_USER=nas_user
NAS_SSH_PASS=your_nas_ssh_password
NAS_SSH_PORT=22

# VU+
VUPLUS_IP=192.168.1.15
ORF1=1:0:19:1389:5:601:FFFF0000:0:0:0:

# Shellies
NAS_SHELLY_IP=192.168.1.28
NAS_SHELLY_RELAY=0
VUPLUS_SHELLY_IP=192.168.1.36
VUPLUS_SHELLY_RELAY=0

# Proxmox API
PROXMOX_HOST=https://proxmox.local:8006
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=root@pam!nas-automation
PROXMOX_TOKEN_SECRET=your_proxmox_token_secret
PBS_TOKEN_ID=proxmox@pbs!nas-automation
PBS_TOKEN_SECRET=your_pbs_token_secret
PBS_HOST=https://pbs.local:8007

# Optional / legacy
PROXMOX_TOKEN_ID2=root@pam!reboot
PROXMOX_TOKEN_SECRET2=your_optional_reboot_token_secret
